[Unit]
Description=100 Journeys API (Go + SQLite)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/100-journeys

[Service]
Type=simple
User=journeys
Group=journeys
WorkingDirectory=/opt/100-journeys/current
EnvironmentFile=/etc/100-journeys/100-journeys.env
ExecStart=/opt/100-journeys/current/bin/server
Restart=always
RestartSec=2
TimeoutStopSec=10

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/100-journeys
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
